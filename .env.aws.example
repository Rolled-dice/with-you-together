# Server-only configuration. Lowercase AWS/DynamoDB/guardrail names are also supported.
# Put real secrets in ignored .env.local or deployment bindings, never VITE_ variables.
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_GUARDRAIL_ID=p1livtmst6bw
BEDROCK_GUARDRAIL_VERSION=1
DYNAMODB_SUMMARY_TABLE=someonenear-ai-user-summaries
DYNAMODB_SAFETY_TABLE=someonenear-ai-safety-audits
# Uploads use private Supabase Storage buckets send-later and prescriptions.
# No S3 bucket or Bedrock inference model is required.

# Dedicated server-only scheduler secret (32+ random characters). Never use a public Supabase key.
CRON_SECRET=
