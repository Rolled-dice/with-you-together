# ============================================================================
# SomeoneNear — LOCAL DEV ENV (localhost, self-owned Supabase Free project)
# ============================================================================
# Copy this file to `.env.local` and fill in the real values.
#   PowerShell:  Copy-Item .env.local.example .env.local
#
# `.env.local` is gitignored — NEVER commit real secrets.
# Only VITE_-prefixed vars are exposed to the browser bundle. Everything else
# is server-only and must stay secret.
#
# NOTE: `.env` (committed) still points at the old Lovable project. `.env.local`
# overrides it for local dev. When you're fully migrated, update `.env` too.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) SUPABASE (your own Free project)
#    Dashboard -> Project Settings -> API
#    - Project URL           -> SUPABASE_URL / VITE_SUPABASE_URL
#    - Project ID (ref)      -> SUPABASE_PROJECT_ID / VITE_SUPABASE_PROJECT_ID
#    - publishable/anon key  -> *_PUBLISHABLE_KEY  (sb_publishable_... or legacy anon JWT)
#    - service_role key      -> SUPABASE_SERVICE_ROLE_KEY  (SECRET - server only)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXX"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_or_service_role_jwt_XXXXXXXX"
# Cron hook routes compare the incoming apikey header against SUPABASE_ANON_KEY
# (falling back to SUPABASE_PUBLISHABLE_KEY). Never use this key for cron hooks.
SUPABASE_ANON_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXX"
CRON_HOOK_SECRET="REPLACE_WITH_RANDOM_PRIVATE_SECRET_AT_LEAST_32_CHARACTERS"

# Client-exposed (browser) copies — must match the server values above.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXX"

# ---------------------------------------------------------------------------
# 2) GEMINI AI (your own key) — powers Companion chat AND prescription OCR
#    Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY="AIza_YOUR_GEMINI_KEY"
# Optional: override the vision model used for prescription OCR (defaults in code).
# GEMINI_VISION_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
# 3) GOOGLE CALENDAR OAUTH (production-mode OAuth client)
#    Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
#    Publishing status: "In production". Enable Google Calendar API.
#    Authorized redirect URI must EXACTLY match GOOGLE_CALENDAR_REDIRECT_URI below.
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID="XXXX.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET="GOCSPX-XXXXXXXX"
# The dev server runs on port 8080 (vite dev). Keep this in sync with the
# Authorized redirect URI you register in Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:8080/api/public/google-calendar/callback"
# AES-GCM key material used to encrypt stored Google refresh tokens.
# Generate a strong random value (see SETUP-LOCALHOST.md for the command).
CALENDAR_TOKEN_ENC_KEY="REPLACE_WITH_A_LONG_RANDOM_STRING"

# ---------------------------------------------------------------------------
# 4) DODO PAYMENTS (TEST mode) — keep sandbox until live rollout is approved.
#    ROTATE the test key/secret that were previously committed in .env.development.
#    Webhook is delivered via a public tunnel (ngrok/cloudflared) to:
#      https://<tunnel-host>/api/public/payments/dodo-webhook?env=test
# ---------------------------------------------------------------------------
DODO_PAYMENTS_ENV="test"
VITE_DODO_MODE="test"
DODO_TEST_API_KEY="ROTATE_ME_dodo_test_api_key"
DODO_TEST_WEBHOOK_SECRET="whsec_ROTATE_ME"
DODO_TEST_PRODUCT_CARE_USD="pdt_XXXX"
DODO_TEST_PRODUCT_CARE_PLUS_USD="pdt_XXXX"
DODO_TEST_PRODUCT_CARE_INR="pdt_XXXX"
DODO_TEST_PRODUCT_CARE_PLUS_INR="pdt_XXXX"

# ---------------------------------------------------------------------------
# 5) TELNYX (outbound calling / phone OTP) — optional for localhost.
#    Leave blank to run with calling degraded; fill to test real calls.
# ---------------------------------------------------------------------------
TELNYX_API_KEY=""
TELNYX_CALL_CONTROL_APP_ID=""
TELNYX_PHONE_NUMBER=""
TELNYX_SIP_CREDENTIAL_ID=""
TELNYX_PUBLIC_KEY=""
# Optional tuning:
# TELNYX_MESSAGING_PROFILE_ID=""
# TELNYX_SMS_SENDER_ID=""
# TELNYX_RECORD_CALLS="false"
# TELNYX_MAX_CALL_SECONDS="1800"
# TELNYX_RING_SECONDS="30"

# ---------------------------------------------------------------------------
# 6) TUNNEL (for Dodo webhook + pg_cron reaching your localhost)
#    Not read by the app — recorded here so the value is in one place.
#    e.g. https://someonenear-dev.ngrok-free.app  (no trailing slash)
# ---------------------------------------------------------------------------
# PUBLIC_TUNNEL_URL="https://YOUR-TUNNEL-HOST"

# ---------------------------------------------------------------------------
# LOVABLE (legacy) — intentionally NOT set for localhost.
#   AI + storage have been migrated to your Gemini key + Supabase Storage.
#   Auth emails use Supabase's built-in SMTP, not the Lovable email webhook.
#   Leaving LOVABLE_API_KEY / AWS_S3_API_KEY unset is expected.
# ---------------------------------------------------------------------------

# Family invitation delivery. SMS flags stay off until sender delivery tests pass.
APP_URL="http://127.0.0.1:8082"
BREVO_API_KEY=""
FAMILY_EMAIL_FROM=""
FAMILY_SMS_ENABLED_IN="false"
FAMILY_SMS_ENABLED_US="false"
FAMILY_PHONE_LOGIN_ENABLED="false"
SUPABASE_SEND_SMS_HOOK_SECRET=""
FAMILY_PUSH_ENABLED="false"
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""
EXTRA_CALLS_ENABLED="false"
EXTRA_CALL_TERMS_READY="false"
EXTRA_CALL_AMOUNT_INR=""
EXTRA_CALL_AMOUNT_USD=""
DODO_TEST_PRODUCT_EXTRA_CALL_INR=""
DODO_TEST_PRODUCT_EXTRA_CALL_USD=""
