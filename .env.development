# Dodo Payments defaults to sandbox mode. Keep it as test until the live rollout
# is deliberately approved and all live credentials, products, and webhook are configured.
DODO_PAYMENTS_ENV="test"
VITE_DODO_MODE="test"

# Server-only secrets: configure real values in .env.local / Lovable Cloud, never here.
DODO_TEST_API_KEY=""
DODO_TEST_WEBHOOK_SECRET=""
DODO_TEST_PRODUCT_CARE_USD=""
DODO_TEST_PRODUCT_CARE_PLUS_USD=""
DODO_TEST_PRODUCT_CARE_INR=""
DODO_TEST_PRODUCT_CARE_PLUS_INR=""

# Live credentials are intentionally empty during Phase A. Add them only before
# enabling DODO_PAYMENTS_ENV="live" in the production deployment.
DODO_LIVE_API_KEY=""
DODO_LIVE_WEBHOOK_SECRET=""
DODO_LIVE_PRODUCT_CARE_USD=""
DODO_LIVE_PRODUCT_CARE_PLUS_USD=""
DODO_LIVE_PRODUCT_CARE_INR=""
DODO_LIVE_PRODUCT_CARE_PLUS_INR=""
