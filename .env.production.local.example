# ============================================================================
# SomeoneNear — PRODUCTION ENV (Cloudflare Worker @ https://www.someonenear.com)
# ============================================================================
# Copy to `.env.production.local` and fill in the REAL production values:
#   PowerShell:  Copy-Item .env.production.local.example .env.production.local
#
# `.env.production.local` is gitignored (matches .env.*.local). NEVER commit it.
#
# Two consumers:
#   1. `pnpm build` bakes the VITE_* values into the browser bundle.
#      -> set VITE_* here (or export them) BEFORE building for production.
#   2. `scripts/upload-worker-secrets.ps1 -EnvFile .env.production.local`
#      uploads the server-side (non-VITE_) values as Cloudflare Worker secrets.
#
# Use a SEPARATE production Supabase project and LIVE payment credentials — do
# not reuse the dev project (jflufaxdwzrohslviqeb) or Dodo test keys here.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) SUPABASE — PRODUCTION project (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROD_REF.supabase.co"
SUPABASE_PROJECT_ID="YOUR_PROD_REF"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_PROD_XXXXXXXX"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_PROD_XXXXXXXX"
# Cron/webhook hooks compare the incoming apikey against SUPABASE_ANON_KEY,
# falling back to SUPABASE_PUBLISHABLE_KEY. Set it EQUAL to the publishable key.
SUPABASE_ANON_KEY="sb_publishable_PROD_XXXXXXXX"

# Browser copies — baked in at build time, must match the server values above.
VITE_SUPABASE_URL="https://YOUR_PROD_REF.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROD_REF"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_PROD_XXXXXXXX"

# ---------------------------------------------------------------------------
# 2) GEMINI AI — Companion chat + prescription OCR
# ---------------------------------------------------------------------------
GEMINI_API_KEY="AIza_PROD_GEMINI_KEY"
# GEMINI_VISION_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
# 3) GOOGLE CALENDAR OAUTH — production client
#    The redirect URI MUST be the production one and MUST be registered in the
#    Google Cloud OAuth client's Authorized redirect URIs.
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID="XXXX.apps.googleusercontent.com"
GOOGLE_CALENDAR_CLIENT_SECRET="GOCSPX-PROD-XXXX"
GOOGLE_CALENDAR_REDIRECT_URI="https://www.someonenear.com/api/public/google-calendar/callback"
CALENDAR_TOKEN_ENC_KEY="REPLACE_WITH_A_LONG_RANDOM_STRING"

# ---------------------------------------------------------------------------
# 4) DODO PAYMENTS — LIVE mode
#    Webhook (set in the Dodo LIVE dashboard) ->
#      https://www.someonenear.com/api/public/payments/dodo-webhook?env=live
# ---------------------------------------------------------------------------
DODO_PAYMENTS_ENV="live"
VITE_DODO_MODE="live"
DODO_LIVE_API_KEY="dodo_live_XXXX"
DODO_LIVE_WEBHOOK_SECRET="whsec_live_XXXX"
DODO_LIVE_PRODUCT_CARE_USD="pdt_XXXX"
DODO_LIVE_PRODUCT_CARE_PLUS_USD="pdt_XXXX"
DODO_LIVE_PRODUCT_CARE_INR="pdt_XXXX"
DODO_LIVE_PRODUCT_CARE_PLUS_INR="pdt_XXXX"

# ---------------------------------------------------------------------------
# 5) TELNYX — outbound calling / phone OTP (production)
#    TELNYX_SIP_CREDENTIAL_ID is the telephony CREDENTIAL uuid, not the app id.
# ---------------------------------------------------------------------------
TELNYX_API_KEY="KEY_PROD_XXXX"
TELNYX_CALL_CONTROL_APP_ID="XXXX"
TELNYX_PHONE_NUMBER="+1XXXXXXXXXX"
TELNYX_SIP_CREDENTIAL_ID="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
TELNYX_PUBLIC_KEY="base64_ed25519_public_key"
# Optional tuning:
# TELNYX_MESSAGING_PROFILE_ID=""
# TELNYX_SMS_SENDER_ID=""
# TELNYX_RECORD_CALLS="false"
# TELNYX_MAX_CALL_SECONDS="1800"
# TELNYX_RING_SECONDS="25"

# ---------------------------------------------------------------------------
# 6) LOVABLE auth email (only if you use the Lovable email webhook for auth)
# ---------------------------------------------------------------------------
# LOVABLE_API_KEY=""
# LOVABLE_SEND_URL=""
